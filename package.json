{
  "name": "@skynote/renderer-leafer",
  "version": "0.1.0-beta.1",
  "type": "module",
  "description": "SkyNote LeaferJS high-performance renderer adapter & scheduler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skynote-universe/renderer-leafer.git"
  },
  "homepage": "https://github.com/skynote-universe/renderer-leafer#readme",
  "bugs": {
    "url": "https://github.com/skynote-universe/renderer-leafer/issues"
  },
  "keywords": [
    "whiteboard",
    "infinite-canvas",
    "canvas",
    "leafer",
    "renderer"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "test": "vitest run --dir tests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "bench": "vitest run --dir bench"
  },
  "dependencies": {
    "@skynote/core": "workspace:*",
    "@leafer-in/color": "2.1.4",
    "leafer-ui": "2.1.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
